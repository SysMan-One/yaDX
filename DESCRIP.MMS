!+
! Rules added by hand
! System also needs to have DX_MSG and DX_CLI added (CREATE_MMS does not
! deal with MSG nor CLD files yet)
!-
$(OLBDIR)dx.OLB(DX_MSG) : $(OBJDIR)DX_MSG.OBJ
$(OLBDIR)dx.OLB(DX_CLI) : $(OBJDIR)DX_CLI.OBJ
$(OBJDIR)DX_MSG.OBJ : DX_MSG.MSG
$(OBJDIR)DX_CLI.OBJ : DX_CLI.CLD
$(INCDIR)GLOBAL.H : $(INCDIR)DX_MSG.H
	@ OPEN/APPEND filout $(INCDIR)GLOBAL.H
	@ CLOSE filout
$(INCDIR)DX_MSG.H : DX_MSG.MSG GEN_MSGH.COM COPYRIGHT.
	@ WRITE SYS$OUTPUT "Generating MSG header file"
	@ @GEN_MSGH.COM $(MMS$SOURCE) $(MMS$TARGET) "DXM__"
DXHELP.HLB : DX.HLP
