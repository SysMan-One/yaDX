  $(OLBDIR)dx.OLB(INQUIRE) \
  @ if (f$search("$(OBJDIR)*.obj") .nes. "") then purge/nolog $(OBJDIR)*.obj
  @ if (f$search("*.lis") .nes. "") then purge/log *.lis

!
! Rules: Now compile all
!
